<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_item"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/margin_card">

    <ImageView
        android:id="@+id/iv_article_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="@string/news_image"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_reports" />

    <TextView
        android:id="@+id/tv_article_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_item"
        android:text="Headline"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/text_size_h3"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_article_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Source"
        android:textColor="@color/colorTextSecondary"
        android:textSize="@dimen/text_size_body2" />

    <TextView
        android:id="@+id/tv_updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2026-04-26"
        android:textColor="@color/colorTextHint"
        android:textSize="@dimen/text_size_caption" />

    <TextView
        android:id="@+id/tv_article_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_item"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="Description"
        android:textColor="@color/colorTextPrimary"
        android:textSize="@dimen/text_size_body2" />

</LinearLayout>

