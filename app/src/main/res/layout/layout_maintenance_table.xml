<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stretchColumns="0,2"
    android:shrinkColumns="1">

    <!-- Header Row -->
    <TableRow android:background="@color/colorTableHeader">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/header_part_name"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_body2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/header_action"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_body2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/header_date"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_body2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/header_cost"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_body2" />
    </TableRow>

    <!-- Row 1: Engine Oil (odd = alt background) -->
    <TableRow android:background="@color/colorRowAlt">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/part_engine_oil"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/action_replaced"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/date_15_mar"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/cost_2500"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />
    </TableRow>

    <!-- Row 2: Brake Pads (even = surface) -->
    <TableRow android:background="@color/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/part_brake_pads"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/action_repaired"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/date_02_apr"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/cost_4800"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />
    </TableRow>

    <!-- Row 3: Battery (odd = alt) -->
    <TableRow android:background="@color/colorRowAlt">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/part_battery"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/action_replaced"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/date_28_feb"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/cost_8500"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />
    </TableRow>

    <!-- Row 4: Air Filter (even = surface) -->
    <TableRow android:background="@color/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/part_air_filter"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/action_inspected"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/date_10_jan"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/cost_500"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />
    </TableRow>

    <!-- Row 5: Tyres (odd = alt) -->
    <TableRow android:background="@color/colorRowAlt">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/part_tyres_x2"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/action_replaced"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/date_05_dec"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/cell_padding"
            android:text="@string/cost_18000"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/colorTextPrimary" />
    </TableRow>

</TableLayout>

