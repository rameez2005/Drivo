<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_drivers"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:title="@string/title_drivers"
        android:titleTextColor="@color/white">

        <ImageView
            android:layout_width="@dimen/size_icon_medium"
            android:layout_height="@dimen/size_icon_medium"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/margin_screen"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/title_drivers" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_item">

            <!-- Driver Card 1: Ali Hassan -->
            <include
                layout="@layout/item_driver_card"
                android:id="@+id/card_ali" />

            <!-- Driver Card 2: Usman Tariq -->
            <include
                layout="@layout/item_driver_card"
                android:id="@+id/card_usman" />

            <!-- Driver Card 3: Bilal Ahmed -->
            <include
                layout="@layout/item_driver_card"
                android:id="@+id/card_bilal" />

            <!-- Driver Card 4: Kamran Sheikh -->
            <include
                layout="@layout/item_driver_card"
                android:id="@+id/card_kamran" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

