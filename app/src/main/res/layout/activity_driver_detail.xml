<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_driver_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            app:title="@string/title_drivers"
            app:titleTextColor="@color/white" />

        <!-- Large Avatar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/colorPrimary"
            android:paddingStart="@dimen/margin_screen"
            android:paddingEnd="@dimen/margin_screen"
            android:paddingTop="@dimen/margin_screen"
            android:paddingBottom="32dp">

            <!-- Avatar circle — large -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:src="@drawable/ic_avatar"
                    android:contentDescription="@string/label_drivers" />
            </FrameLayout>

            <!-- Driver Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_card"
                android:text="@string/driver_ali_hassan"
                android:textSize="@dimen/text_size_h1"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/phone_ali"
                android:textSize="@dimen/text_size_body1"
                android:textColor="@color/white"
                android:gravity="center" />

            <!-- Status chip row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_item">

                <View
                    android:layout_width="@dimen/size_status_dot"
                    android:layout_height="@dimen/size_status_dot"
                    android:background="@drawable/bg_status_dot_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_available"
                    android:textSize="@dimen/text_size_body2"
                    android:textColor="@color/white"
                    android:layout_marginStart="@dimen/margin_item" />
            </LinearLayout>
        </LinearLayout>

        <!-- Driver Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/margin_screen"
            android:layout_marginStart="@dimen/margin_screen"
            android:layout_marginEnd="@dimen/margin_screen"
            android:layout_marginTop="-16dp"
            android:elevation="@dimen/elevation_card">

            <!-- Assigned Vehicle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_vehicles"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/colorTextHint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/vehicle_lea"
                android:textSize="@dimen/text_size_body1"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="@dimen/margin_card"
                android:layout_marginBottom="@dimen/margin_card" />

            <!-- Route -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/route_lahore"
                android:textSize="@dimen/text_size_body2"
                android:textColor="@color/colorTextSecondary"
                android:drawableStart="@drawable/ic_vehicle"
                android:drawablePadding="@dimen/margin_item" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="@dimen/margin_card"
                android:layout_marginBottom="@dimen/margin_card" />

            <!-- Salary info row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/size_icon_medium"
                    android:layout_height="@dimen/size_icon_medium"
                    android:src="@drawable/ic_salary"
                    android:contentDescription="@string/card_salary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_item"
                    android:text="@string/card_salary"
                    android:textSize="@dimen/text_size_body1"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amount_25000"
                    android:textSize="@dimen/text_size_body1"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stats Bar (L3 — attendance / dues / rating) -->
        <include
            layout="@layout/layout_stats_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_screen"
            android:layout_marginStart="@dimen/margin_screen"
            android:layout_marginEnd="@dimen/margin_screen" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

